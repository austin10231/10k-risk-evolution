# Railway backend environment variables (example)
# Copy into Railway -> Service -> Variables

# Core AWS
AWS_ACCESS_KEY_ID=REPLACE_ME_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_ME_AWS_SECRET_ACCESS_KEY
AWS_REGION=us-west-1
BEDROCK_REGION=us-west-2
S3_BUCKET=REPLACE_ME_S3_BUCKET

# AgentCore runtime
AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:REGION:ACCOUNT_ID:runtime/REPLACE_ME
AGENTCORE_QUALIFIER=
AGENTCORE_REGION=us-west-2

# Bedrock dual-model split
# - BEDROCK_EXTRACTION_MODEL_ID: risk extraction, dashboard 9-bucket
#   classification, RPI three-dim scoring, agent priority report.
# - BEDROCK_AGENT_MODEL_ID: chat agent (user Q&A, language polishing, identity).
# Both default to the values below when unset; override only if your account
# has different inference-profile IDs enabled in BEDROCK_REGION.
BEDROCK_EXTRACTION_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_AGENT_MODEL_ID=deepseek.v3-v1:0

# Optional AWS session token (leave empty if not used)
AWS_SESSION_TOKEN=

# External APIs
MARKETAUX_API_TOKEN=REPLACE_ME_MARKETAUX_API_TOKEN
TWELVEDATA_API_KEY=REPLACE_ME_TWELVEDATA_API_KEY

# Optional regions
COMPREHEND_REGION=us-west-1

# Backend app settings
ENVIRONMENT=production
LOG_LEVEL=INFO

# Public app/API URLs used by Cognito redirects and cookie scope.
# Production should use a same-site API domain, not the raw Railway domain,
# so browsers treat the session cookie as first-party for app.risklensai.org.
APP_BASE_URL=https://app.risklensai.org
PUBLIC_API_BASE_URL=https://api.risklensai.org

# CORS: comma-separated allowed frontend origins. Keep this concrete because
# cookie-based auth uses credentials and browsers reject wildcard credentials.
CORS_ALLOW_ORIGINS=https://app.risklensai.org,https://risklens-ai.pages.dev,http://localhost:5173

# Cognito Hosted UI / OAuth
COGNITO_DOMAIN=https://YOUR_COGNITO_DOMAIN.auth.YOUR_REGION.amazoncognito.com
COGNITO_CLIENT_ID=REPLACE_ME_COGNITO_CLIENT_ID
COGNITO_CLIENT_SECRET=
COGNITO_SCOPE=openid email profile
COGNITO_REDIRECT_URI=https://api.risklensai.org/api/auth/callback
COGNITO_ALLOWED_CALLBACK_URLS=https://api.risklensai.org/api/auth/callback
COGNITO_LOGOUT_REDIRECT_URI=https://app.risklensai.org/agent
COGNITO_ALLOWED_SIGNOUT_URLS=https://app.risklensai.org/agent
COGNITO_PROMPT=select_account

# Session cookie settings. For app.risklensai.org + api.risklensai.org use
# a shared parent domain and SameSite=Lax to avoid third-party-cookie blocking.
RISKLENS_SESSION_SECRET=REPLACE_ME_LONG_RANDOM_SECRET
AUTH_COOKIE_DOMAIN=.risklensai.org
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_SECURE=1
AUTH_RETURN_TO_ALLOWLIST=https://app.risklensai.org,https://risklens-ai.pages.dev,https://risklensai.org
