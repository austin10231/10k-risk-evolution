# Cloudflare Pages frontend environment variables (example)
# Only public-safe values should be put here.

# Landing page only needs public-safe metadata.
# Product frontend (frontend/) uses VITE_API_BASE_URL; see
# deploy/cloudflare-product-frontend.env.example.
PUBLIC_API_BASE_URL=https://api.risklensai.org

# Cognito is completed by the backend OAuth endpoints. Do not put a client
# secret in Cloudflare Pages variables.

# Optional frontend app metadata
PUBLIC_APP_ENV=production
